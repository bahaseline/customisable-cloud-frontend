# Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# JWT
JWT_SECRET=your_jwt_secret_here

# Token encryption (access_token/refresh_token at rest) — generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=your_token_encryption_key_here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ista1

# Server
PORT=3001
CLIENT_URL=http://localhost:3000
