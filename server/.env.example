# Copy this file to server/.env and fill in the values.
# The server reads .env from the server/ directory, not the repository root.

# Google OAuth2 — create credentials at https://console.cloud.google.com
# Authorised redirect URI must match GOOGLE_CALLBACK_URL exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Signs the session tokens. Generate with: openssl rand -hex 32
JWT_SECRET=

# Encrypts the stored Google tokens (AES-256-GCM). Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# PostgreSQL connection string for a database you have already created.
DATABASE_URL=postgresql://user@localhost:5432/ista1

# Optional — defaults to 3001 and http://localhost:3000 respectively.
PORT=3001
CLIENT_URL=http://localhost:3000
